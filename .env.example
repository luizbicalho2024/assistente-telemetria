APP_NAME="Assistente Telemetria"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8080
APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mongodb
MONGODB_URI=mongodb://mongo:27017
MONGODB_DATABASE=assistente_telemetria

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Primeiro administrador.
# Obrigatório na primeira inicialização. Não existe senha padrão.
ADMIN_NAME=Administrador
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=

# Origem de dados legada, opcional. Prefira variáveis de ambiente/arquivo local
# e nunca informe URI com credenciais diretamente na linha de comando.
LEGACY_SIMULADOR_MONGODB_URI=
LEGACY_SIMULADOR_MONGODB_DATABASE=simulador_db
LEGACY_FINANCEIRO_MONGODB_URI=
LEGACY_FINANCEIRO_MONGODB_DATABASE=financeiro_verdio

# SMS opcional (Twilio REST). Sem estas variáveis os comandos continuam sendo gerados.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Docker
APP_BIND_IP=127.0.0.1
APP_PORT=8080
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=
MONGO_APP_USER=assistente
MONGO_APP_PASSWORD=
