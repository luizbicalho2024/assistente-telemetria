APP_NAME="Assistente Telemetria"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mongodb
MONGODB_URI=mongodb://mongo:27017
MONGODB_DATABASE=assistente_telemetria

SESSION_DRIVER=file
SESSION_LIFETIME=480
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Primeiro administrador (usado pelo comando app:bootstrap)
ADMIN_NAME=Administrador
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=TroqueEstaSenha123!

# Origem de dados legada, opcional. Preencha apenas quando for importar.
LEGACY_SIMULADOR_MONGODB_URI=
LEGACY_SIMULADOR_MONGODB_DATABASE=simulador_db
LEGACY_FINANCEIRO_MONGODB_URI=
LEGACY_FINANCEIRO_MONGODB_DATABASE=financeiro_verdio

# SMS opcional (Twilio REST). Sem estas variáveis os comandos continuam sendo gerados.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=


# Docker MongoDB
APP_PORT=8080
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=TroqueRootMongo123!
MONGO_APP_USER=assistente
MONGO_APP_PASSWORD=TroqueMongoAgora123!
