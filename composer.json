{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "luizbicalho2024/assistente-telemetria",
  "type": "project",
  "description": "Plataforma unificada Laravel para Simulador de Telemetria e Financeiro Verdio.",
  "keywords": ["laravel", "mongodb", "telemetria", "financeiro", "simulador"],
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "ext-ctype": "*",
    "ext-curl": "*",
    "ext-fileinfo": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-mongodb": "*",
    "ext-openssl": "*",
    "ext-zip": "*",
    "laravel/framework": "^13.17",
    "laravel/tinker": "^3.0",
    "mongodb/laravel-mongodb": "^5.9",
    "phpoffice/phpspreadsheet": "^5.1"
  },
  "require-dev": {
    "fakerphp/faker": "^1.24",
    "laravel/pail": "^1.2.2",
    "laravel/pint": "^1.24",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.8",
    "phpunit/phpunit": "^12.4"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi"
    ],
    "test": [
      "@php artisan test"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
